import sys

x = 0.0
f= "乗車した"
t = "の数値を入力してください"
if len(sys.argv) < 2:
    print(f"入力が足りません、{f}時間と分{t}")
    exit(1)
elif 2 < len(sys.argv) < 5:
    x = (-(-float(sys.argv[2]) // 10) + float(sys.argv[1]) * 6)150
    if 4280 <= x <= 5400:
        x = 4280
    elif 5700 <= x <= 10800:
        x = 5700
    elif 7300 <= x <= 21600:
        x = 7300
    if x > 360:
        if len(sys.argv) < 5:
            x += float(sys.argv[3]) * 21
        else:
            print("6時間以上なので距離料金を含めて計算する必要があります、走行距離を入力してください")
            exit(1)
else:
    print(f"入力が多すぎます、{f}時間と分{t}")
    exit(1)
print(x)
exit(0)
