import sys

x = 0.0
y = 0.0
f= "乗車した"
t = "の数値を入力してください"
if len(sys.argv) < 3:
    print(f"入力が足りません、{f}時間と分{t}")
    exit(1)
elif 2 < len(sys.argv) < 5:
    x = -(-float(sys.argv[2]) // 10) * 10 + float(sys.argv[1]) * 60
    y = x * 15
    if 4280 <= y <= 5400:
        y = 4280.0
    elif 5700 <= y <= 10800:
        y = 5700.0
    elif 7300 <= y <= 21600:
        y = 7300.0
    if x > 360:
        if len(sys.argv) == 4:
            y += float(sys.argv[3]) * 21
        else:
            print("6時間以上なので距離料金を含めて計算する必要があります、走行距離を入力してください")
            exit(1)
else:
    print(f"入力が多すぎます、{f}時間と分{t}")
    exit(1)
print(y)
exit(0)
