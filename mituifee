#! /usr/bin/python3

import sys

x = 0.0
f= "乗車した"
t = "の数値を入力してください"
if len(sys.argv) < 3:
    print("入力が足りません、{f}時間と分{t}")
    exit()
elif len(sys.argv) == 3:
    x = float(sys.argv[2]) / 60 + float(sys.argv[3])
    if x <= 6:
        x *= 900
        if x >= 4280:
            x = 4280
    else:
        print("6時間以上なので距離料金を含めて計算する必要があります")
        exit()
else:
    print("入力が多すぎます、{f}時間と分{t}")
    exit()
print(x)
exit()
